                            <div class="tech-item">
                                <span class="tech-label">Database</span>
                                <span class="tech-value">MongoDB (NoSQL)</span>
                            </div>
                            <div class="tech-item">
                                <span class="tech-label">ODM</span>
                                <span class="tech-value">PyMongo</span>
                            </div>
                            <div class="tech-item">
                                <span class="tech-label">Frontend</span>
                                <span class="tech-value">HTML/CSS/JS</span>
                            </div>
                            <div class="tech-item">
                                <span class="tech-label">Charts</span>
                                <span class="tech-value">Chart.js</span>
                            </div>
                            <div class="tech-item">
                                <span class="tech-label">i18n</span>
