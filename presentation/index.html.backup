        <!-- Slide 3: NoSQL Justification -->
        <section class="slide" data-slide="3">
            <div class="slide-content">
                <h2 class="slide-title">🗄️ Pourquoi NoSQL (MongoDB) ?</h2>
                <div class="grid-3">
                    <div class="card">
                        <div class="card-icon">🔄</div>
                        <h3>Flexibilité du Schéma</h3>
                        <p>Ajout de champs sans migration complexe. Évolution naturelle du modèle de données.</p>
                    </div>
                    <div class="card">
                        <div class="card-icon">📦</div>
                        <h3>Documents Embarqués</h3>
                        <p>Historique des emprunts intégré. Pas de JOIN coûteux, une seule requête.</p>
                    </div>
                    <div class="card">
                        <div class="card-icon">⚡</div>
                        <h3>Performance Optimale</h3>
                        <p>Application read-heavy. Lecture rapide avec embedded documents.</p>
                    </div>
                    <div class="card">
                        <div class="card-icon">📊</div>
                        <h3>Agrégations Puissantes</h3>
                        <p>Pipeline d'agrégation MongoDB pour analyses complexes et statistiques.</p>
                    </div>
                    <div class="card">
                        <div class="card-icon">📈</div>
                        <h3>Scalabilité Horizontale</h3>
                        <p>Sharding automatique pour croissance future de la bibliothèque.</p>
                    </div>
                    <div class="card">
                        <div class="card-icon">💾</div>
                        <h3>Snapshots Immuables</h3>
                        <p>Conservation de l'historique même après modification/suppression des livres.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Slide 4: Collections Schema -->
        <section class="slide" data-slide="4">
            <div class="slide-content">
                <h2 class="slide-title">📝 Schéma des Collections MongoDB</h2>
                <div class="two-column">
                    <div class="column">
                        <h3>Collection: <code>books</code></h3>
                        <div class="code-block">
                            <pre><code>{
  "_id": ObjectId("..."),
  "title": "1984",
  "author": "George Orwell",
  "category": "Classic",
  "description": "...",
  "cover_image": "url",
  "total_copies": 5,
  "available_copies": 3,
  "added_at": ISODate(),
  "current_loans": [
    {
      "loan_id": ObjectId(),
      "user_id": ObjectId(),
      "user_name": "Andro",
      "borrow_date": ISODate(),
      "deadline": ISODate(),
      "status": "Borrowed"
    }
  ],
  "loan_history": [...]
}</code></pre>
                        </div>
                    </div>
                    <div class="column">
                        <h3>Collection: <code>users</code></h3>
                        <div class="code-block">
                            <pre><code>{
  "_id": ObjectId("..."),
  "username": "Andro",
  "email": "andro@lib.com",
  "password": "$2b$12...",
  "role": "user",
  "created_at": ISODate(),
  "books_read": 15,
  "categories_explored": [...],
  "badges": [
    "Welcome",
    "First Reader",
    "Bookworm"
  ],
  "loans": [
    {
      "loan_id": ObjectId(),
      "book_snapshot": {
        "title": "1984",
        "author": "George Orwell"
      },
      "borrow_date": ISODate(),
      "status": "Returned"
    }
  ]
}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Slide 5: Database Operations -->
        <section class="slide" data-slide="5">
            <div class="slide-content">
                <h2 class="slide-title">🔹 Opérations CRUD - Exemples</h2>
                <div class="operations-grid">
                    <div class="operation-card">
                        <h3>CREATE - Ajouter un Livre</h3>
                        <div class="code-block small">
                            <pre><code class="language-python">def add_book(title, author, category):
    db = get_db()
    book = {
        "title": title,
        "author": author,
        "category": category,
        "total_copies": 5,
        "available_copies": 5,
        "added_at": datetime.utcnow(),
        "current_loans": [],
        "loan_history": []
    }
    result = db.books.insert_one(book)
    return result.inserted_id</code></pre>
                        </div>
                    </div>
                    <div class="operation-card">
                        <h3>READ - Recherche de Livres</h3>
                        <div class="code-block small">
                            <pre><code class="language-python">def search_books(query):
    db = get_db()
    books = db.books.find({
        "$or": [
            {"title": {"$regex": query, 
                      "$options": "i"}},
            {"author": {"$regex": query,
                       "$options": "i"}},
            {"category": {"$regex": query,
                         "$options": "i"}}
        ]
    })
    return list(books)</code></pre>
                        </div>
                    </div>
                    <div class="operation-card">
                        <h3>UPDATE - Créer un Emprunt</h3>
                        <div class="code-block small">
                            <pre><code class="language-python">def create_loan(user_id, book_id):
    db = get_db()
    # Update user: add to loans array
    db.users.update_one(
        {"_id": ObjectId(user_id)},
        {
            "$push": {"loans": {...}},
            "$inc": {"books_read": 1}
        }
    )
    # Update book: decrease available
    db.books.update_one(
        {"_id": ObjectId(book_id)},
        {"$inc": {"available_copies": -1}}
    )</code></pre>
                        </div>
                    </div>
                    <div class="operation-card">
                        <h3>AGGREGATE - Statistiques</h3>
                        <div class="code-block small">
                            <pre><code class="language-python">def get_loans_by_category():
    db = get_db()
    pipeline = [
        {"$unwind": "$loans"},
        {
            "$group": {
                "_id": "$loans.book_snapshot.category",
                "count": {"$sum": 1}
            }
        },
        {"$sort": {"count": -1}}
    ]
    return list(db.users.aggregate(pipeline))</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Slide 6: Architecture -->
        <section class="slide" data-slide="6">
            <div class="slide-content">
                <h2 class="slide-title">🖥️ Architecture de l'Application</h2>
                <div class="architecture-diagram">
                    <div class="arch-layer">
                        <div class="arch-box frontend">
                            <h3>Frontend</h3>
                            <p>HTML5 • CSS3 • JavaScript</p>
                            <p>Chart.js • Responsive Design</p>
                        </div>
                    </div>
                    <div class="arch-arrow">↓ HTTP Requests</div>
                    <div class="arch-layer">
                        <div class="arch-box backend">
                            <h3>Flask Backend</h3>
                            <p>Routing • Authentication</p>
                            <p>Business Logic • Session Management</p>
                        </div>
                    </div>
                    <div class="arch-arrow">↓ Function Calls</div>
                    <div class="arch-layer">
                        <div class="arch-box data">
                            <h3>Data Layer (utils/queries.py)</h3>
                            <p>CRUD Operations • Aggregations</p>
                            <p>Business Rules • Validation</p>
                        </div>
                    </div>
                    <div class="arch-arrow">↓ PyMongo Queries</div>
                    <div class="arch-layer">
                        <div class="arch-box database">
                            <h3>MongoDB Database</h3>
                            <p>Collections: users, books</p>
                            <p>Embedded Documents • Indexes</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

